# Copy to outreach/.env. ../.env.local is also loaded (Supabase URL/anon key
# for the live service-fee rate); values here win.

# Claude API (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Google Places API (New) — enable "Places API (New)" in Google Cloud
GOOGLE_PLACES_API_KEY=

# Cold email. Use a SEPARATE domain verified in Resend, never rentivo.live —
# cold-email complaints would drag booking/payout emails into spam.
OUTREACH_RESEND_API_KEY=
OUTREACH_EMAIL_FROM="JP from Rentivo <jp@hello.getrentivo.com>"
OUTREACH_REPLY_TO=rentivo02@gmail.com
OUTREACH_DAILY_EMAIL_CAP=30

# Signs the messages ("— JP, Rentivo")
OUTREACH_SENDER_NAME=JP/Isse

# Follow-ups after the first message (0 = message each host once, the default)
OUTREACH_MAX_FOLLOWUPS=0

# Optional overrides: leads database path (default outreach/data/leads.db) and Claude model
# OUTREACH_DB=
# OUTREACH_MODEL=
