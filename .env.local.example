# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase secret key (newer name for the service role key; either works):
# Supabase > Project Settings > API Keys
SUPABASE_SECRET_KEY=

# PayMongo webhook signature secret: PayMongo dashboard > Developers > Webhooks
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated payment methods to hide, e.g. gcash,maya,card (inlined at build time)
NEXT_PUBLIC_DISABLED_PAYMENT_METHODS=

# Transactional email: resend.com > API Keys
RESEND_API_KEY=
# e.g. Rentivo <noreply@rentivo.live>
EMAIL_FROM=

# Admin panel allowlist: comma-separated emails
ADMIN_EMAILS=

# Written by `vercel env pull`; short-lived, not set by hand
# VERCEL_OIDC_TOKEN=

# Not read by the code any more (removed from production 2026-09-14)
# CRON_SECRET=

# scripts/verify/skeleton-loading.mjs only: base URL (default http://localhost:3102)
# SKEL_BASE=
